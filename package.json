{
  "name": "jbrowse-plugin-tandem-repeat",
  "version": "0.1.0",
  "description": "A JBrowse 2 view for tandem repeat arrays, on an axis of copy index rather than reference coordinates",
  "keywords": ["jbrowse", "jbrowse2", "tandem repeat", "VNTR"],
  "license": "MIT",
  "type": "module",
  "main": "dist/jbrowse-plugin-tandem-repeat.esm.js",
  "files": ["dist", "src"],
  "scripts": {
    "clean": "rimraf dist",
    "format": "pnpm prettier --write .",
    "prebuild": "pnpm clean",
    "dev": "pnpm start",
    "start": "node esbuild.mjs --watch",
    "build": "NODE_ENV=production node esbuild.mjs",
    "build:bundle": "NODE_ENV=production node esbuild.mjs",
    "typecheck": "tsc",
    "lint": "eslint --report-unused-disable-directives --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "pnpm build",
    "preversion": "pnpm lint && pnpm typecheck && pnpm test",
    "postversion": "git push --follow-tags"
  },
  "devDependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@eslint/js": "^10.0.1",
    "@fal-works/esbuild-plugin-global-externals": "^2.1.2",
    "@jbrowse/mobx-state-tree": "^6.1.0",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "esbuild": "^0.28.1",
    "eslint": "^10.8.0",
    "eslint-plugin-import-x": "^4.17.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^30.0.1",
    "mobx": "^7.0.0",
    "mobx-react": "^10.0.0",
    "prettier": "^3.9.6",
    "pretty-bytes": "^7.1.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@jbrowse/core": "link:../../jbrowse-components/packages/core"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  }
}
